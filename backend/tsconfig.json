{
  "compilerOptions": {
    "paths": {
      "@domain/*": ["./src/domain/*"],
      "@integrations/*": ["./src/integrations/*"],
      "@http/*": ["./src/http/*"]
    },
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["node", "express"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.js",
    "src/utils/validateEnv.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
