{
  "name": "spotify-backend",
  "version": "1.0.0",
  "description": "Backend for Spotify auth and user data",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.js",
    "start": "tsx src/server.js",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-session": "^1.19.0",
    "ml-kmeans": "^7.0.1",
    "ml-pca": "^4.1.1",
    "prettier": "^2.8.8",
    "swagger-ui-express": "^5.0.1",
    "tsx": "^4.23.12"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^26.3.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
