{
  "name": "beat-route",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently --raw \"npm run frontend:start\" \"npm run backend:dev\"",
    "frontend:start": "npm --prefix frontend run start",
    "backend:dev": "npm --prefix backend run dev",
    "frontend:build": "npm --prefix frontend run build",
    "format": "npm --prefix frontend run format && npm --prefix backend run format",
    "format:check": "npm --prefix frontend run format:check && npm --prefix backend run format:check",
    "prepare": "husky"
  },
  "lint-staged": {
    "frontend/**/*.{ts,html,scss,css,json,md}": "npm --prefix frontend exec -- prettier --write",
    "backend/**/*.{ts,js,json,md}": "npm --prefix backend exec -- prettier --write"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1"
  }
}
