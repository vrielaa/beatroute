{
  "name": "beat-route",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently --raw \"npm run frontend:start\" \"npm run backend:dev\"",
    "frontend:start": "npm --prefix frontend run start",
    "backend:dev": "npm --prefix backend run dev",
    "frontend:build": "npm --prefix frontend run build",
    "format": "npm --prefix frontend run format && npm --prefix backend run format"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
